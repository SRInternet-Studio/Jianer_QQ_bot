# 和风天气API相关配置
QWEATHER_API_HOST=your-api-host.qweatherapi.com
QWEATHER_PROJECT_ID=your-project-id
QWEATHER_CREDENTIAL_ID=your-credential-id
# Relative paths are resolved from the repository root. PEM/key files are ignored.
QWEATHER_PRIVATE_KEY_PATH=secrets/qweather-ed25519-private.pem

# JianerAI 网页搜索相关配置
# 搜索提供方：ddgs（默认，使用下面的 DDGS_BACKEND）或 deepseek（DeepSeek 官方网页搜索 API）
WEB_SEARCH_PROVIDER=ddgs
# DDGS 默认搜索后端；可选值取决于安装的 ddgs text 引擎，另支持 zhipu/bocha/bing_cn；
# ddgs 没有 bing text 引擎时，bing 会走内置直连 Bing
DDGS_BACKEND=bing
# DDGS 超时或网络错误后的国内回退顺序；可含 deepseek，未配置 key 的后端会自动跳过
WEB_SEARCH_FALLBACK_BACKENDS=zhipu,bocha,bing_cn
# WEB_SEARCH_PROVIDER=deepseek 或回退链包含 deepseek 时必填
DEEPSEEK_API_KEY=
# 智谱联网搜索的 API Key，https://open.bigmodel.cn/
ZHIPUAI_API_KEY=
# 博查 Web Search 的 API Key，https://open.bochaai.com/
BOCHA_API_KEY=

# 舞萌DX插件相关配置
# 静态资源目录；首次启动会在后台自动下载基础包和 1.56 增量包
MAIMAIDX_PATH=data/maimaidx/static
# 用户数据库、OAuth Token 和安装状态；必须限制访问权限并定期备份
MAIMAIDX_STATE_PATH=data/maimaidx/private
# true 表示首次启动自动下载，下载进度输出到机器人控制台，不发送群聊或私聊通知
MAIMAIDX_AUTO_DOWNLOAD=true
# true 表示自动执行 python -m playwright install chromium
MAIMAIDX_AUTO_INSTALL_CHROMIUM=true
# 以下均为可选覆盖项，默认使用上游 Cloudreve 地址
# MAIMAIDX_RESOURCE_ARCHIVE=/path/to/Resource CN1.55.7z
# MAIMAIDX_RESOURCE_URL=
# MAIMAIDX_RESOURCE_SHA256=
# MAIMAIDX_RESOURCE_UPDATE_URL=
# MAIMAIDX_RESOURCE_UPDATE_SHA256=
# 是否推送 Yuri-YuzuChaN 别名 SSE 事件
MAIMAIDX_ALIAS_PUSH=true
# 境外服务器可改为 true，通过中转访问别名服务
MAIMAIDX_ALIAS_PROXY=false
# 是否把常用素材缓存在内存中
SAVE_IN_MEMORY=true
# true 时名牌和图标优先读取在线素材；离线部署时改为 false
ASSETS_ONLINE=true

# 水鱼查分器相关配置
# 开发者 Token 已弃用；使用 OAuth 时保持为空
DIVINGFISH_TOKEN=
# 在 https://auth.diving-fish.com/apps 申请 OAuth 应用后填写
DIVINGFISH_CLIENT_ID=
DIVINGFISH_CLIENT_SECRET=
DIVINGFISH_SCOPE=prober.profile.read
DIVINGFISH_AUTH_URL=https://auth.diving-fish.com
# 水鱼官方接口通常不需要代理；不要配置会转发凭据的第三方代理
DIVINGFISH_PROBER_PROXY=false

# 落雪查分器与 OAuth
# 开发者 Token 用于曲目和别名数据同步；绑定用户仍需 OAuth
LXNS_DEV_TOKEN=
# 落雪 OAuth 应用凭据
LX_CLIENT_ID=
LX_CLIENT_SECRET=
# 注意勾选落雪 OAuth 应用的“无回调地址”
REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob
LXNS_BIND_PRIVATE_ONLY=true
