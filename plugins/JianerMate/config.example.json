{
    "_readme": "JianerMate 插件配置示例。首次启用插件时会自动在 data/jianer_mate/config.json 生成一份；这里的值优先于宿主 config.json 里的 jianer_mate_* 键，改完发送 ~主动发言 重载 生效。",
    "enabled": true,
    "data_dir": "data/jianer_mate",
    "ai_config_dir": "aiconfig",
    "models": {
        "planner": "deepseek",
        "replyer": "vision-primary"
    },
    "moderation": {
        "enabled": false,
        "model": "deepseek"
    },
    "persona": {
        "name": "简儿",
        "aliases": [
            "小简",
            "Jianer"
        ],
        "personality": "你是常年混在 QQ 群里的普通群友，性格轻松、嘴甜、有点机灵，不端着，也不刻意卖萌。",
        "behavior_style": "只在有话可说时开口，优先接住群里正在聊的话题；不刷屏、不抢话、不复读别人刚说过的话；被 @ 时认真回应，不敷衍。",
        "reply_style": "说话要短，像真人打字：一次最多两三条，每条尽量不超过二十个字；用日常口语，不用 Markdown、不列清单、不写长段落、不复述问题。",
        "group_chat_prompt": "你正在 QQ 群里和群友聊天，回复尽量简短，一次只接一个话题；控制发言频率，不用回复每个人的消息。",
        "private_chat_prompt": "你正在私聊里聊天，回复尽量简短、自然，看对方的发言频率决定接话节奏。",
        "multiple_reply_styles": [
            "用1-2个字回复",
            "带点翻译腔，但不要太长"
        ],
        "multiple_probability": 0.0
    },
    "style": {
        "max_parts": 3,
        "max_chars": 24,
        "delay_ms": [
            600,
            1800
        ],
        "typo_probability": 0.08,
        "typo_correction": true,
        "kaomoji_probability": 0.15,
        "kaomoji": [
            "(￣▽￣)",
            "ovo",
            "qwq",
            "嘿嘿",
            "欸嘿"
        ],
        "catchphrases": [
            "确实",
            "好耶",
            "emmm",
            "哈哈",
            "啊这"
        ]
    },
    "proactive": {
        "talk_value": 0.5,
        "min_interval_seconds": 30,
        "debounce_seconds": 3,
        "max_debounce_seconds": 15,
        "quiet_hours": "23:00-08:00",
        "mentioned_reply": true,
        "reply_at": false,
        "backoff_base_seconds": 15,
        "backoff_cap_seconds": 300,
        "backoff_start_count": 2
    },
    "context": {
        "messages": 40,
        "keep_messages": 300,
        "retention_days": 7
    },
    "memes": {
        "enabled": true,
        "steal_emoji": true,
        "max_entries": 128,
        "max_size_mb": 5.0,
        "max_dimension": 4096,
        "candidates": 8,
        "thumbnail_px": 512,
        "reuse_cooldown_seconds": 3600
    },
    "limits": {
        "max_concurrent_ai": 2,
        "request_timeout_seconds": 60
    },
    "tools": {
        "enabled": true,
        "max_rounds": 3,
        "include_web_browser": false,
        "allow_mutating": false,
        "allowlist": [
            "get_current_time",
            "calculate_expression",
            "get_current_user_profile",
            "get_current_chat_info",
            "read_recent_chat",
            "search_current_chat",
            "web_search",
            "github_repository",
            "render_information_card",
            "list_agent_skills",
            "load_agent_skill",
            "read_agent_skill_resource"
        ],
        "max_output_chars": 4000,
        "skills_dirs": [
            ".agents/skills"
        ],
        "skills_max_file_bytes": 65536,
        "mcp_enabled": false,
        "mcp_servers": [],
        "bash_enabled": false,
        "bash_approval_timeout_seconds": 120,
        "bash_command_timeout_seconds": 60,
        "subagents_enabled": false,
        "subagent_max_concurrency": 3,
        "subagent_max_tasks": 4,
        "subagent_timeout_seconds": 120
    },
    "group_blacklist": [],
    "memory": {
        "enabled": true,
        "backend": "memorix",
        "db_path": "data/jianer_mate/memory.db",
        "data_dir": "data/jianer_mate/memorix",
        "embedding_config_path": "aiconfig/embedding.json",
        "console_enabled": false,
        "console_host": "127.0.0.1",
        "console_port": 8787
    },
    "tts": {
        "enabled": false,
        "options": {
            "voice": "zh-CN-XiaoyiNeural",
            "rate": "+0%",
            "volume": "+0%",
            "pitch": "+0Hz"
        }
    },
    "suffix": {
        "enabled": true,
        "config_path": "suffix_config.json"
    }
}
